<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_satu_data_root"
              name="Satu Data"
              web_icon="satu_data,static/description/icon.png"
              groups="satu_data.group_satu_data_pengguna"
              sequence="1"/>
    <!-- sequence 1: aplikasi pertama di menu utama, sehingga dibuka otomatis setelah
         login (Discuss bawaan = 5). Pengguna dengan "Home Action" sendiri tidak terpengaruh. -->

    <!-- Dashboard: sidebar kiri berisi dashboard tiap modul sektor yang terpasang. -->
    <menuitem id="menu_satu_data_dashboard_utama" name="Dashboard"
              parent="menu_satu_data_root" action="action_dashboard"
              groups="satu_data.group_satu_data_pengguna" sequence="1"/>

    <!-- Laporan Data: tiap modul sektor menambahkan submenu di sini. -->
    <menuitem id="menu_satu_data_data" name="Laporan Data"
              parent="menu_satu_data_root" sequence="10"/>

    <!-- Tata Kelola: Daftar Data, metadata, Forum, dan master wilayah -->
    <menuitem id="menu_satu_data_katalog" name="Tata Kelola"
              parent="menu_satu_data_root"
              groups="satu_data.group_satu_data_walidata,satu_data.group_satu_data_pembina"
              sequence="60"/>
    <menuitem id="menu_satu_data_daftar_data" name="Daftar Data"
              parent="menu_satu_data_katalog" action="action_data"
              groups="satu_data.group_satu_data_pengguna" sequence="1"/>
    <menuitem id="menu_satu_data_kegiatan" name="Metadata Kegiatan"
              parent="menu_satu_data_katalog" action="action_kegiatan"
              groups="satu_data.group_satu_data_pengguna" sequence="2"/>
    <menuitem id="menu_satu_data_forum" name="Forum Satu Data"
              parent="menu_satu_data_katalog" action="action_forum"
              groups="satu_data.group_satu_data_pengguna" sequence="3"/>

    <!-- Antrean pemeriksaan Walidata -->
    <menuitem id="menu_satu_data_pemeriksaan" name="Pemeriksaan"
              parent="menu_satu_data_root" action="action_pengajuan"
              groups="satu_data.group_satu_data_walidata" sequence="18"/>

    <menuitem id="menu_satu_data_kecamatan" name="Kecamatan"
              parent="menu_satu_data_katalog" action="action_kecamatan"
              groups="satu_data.group_satu_data_pengguna" sequence="10"/>
    <menuitem id="menu_satu_data_desa" name="Desa/Kelurahan"
              parent="menu_satu_data_katalog" action="action_desa"
              groups="satu_data.group_satu_data_pengguna" sequence="11"/>

    <!-- Konfigurasi: admin -->
    <menuitem id="menu_satu_data_konfigurasi" name="Konfigurasi"
              parent="menu_satu_data_root" groups="satu_data.group_satu_data_admin" sequence="90"/>
    <menuitem id="menu_satu_data_identitas" name="Identitas Wilayah"
              parent="menu_satu_data_konfigurasi" action="action_identitas_wilayah"
              groups="satu_data.group_satu_data_admin" sequence="1"/>
    <menuitem id="menu_satu_data_periode" name="Periode Data"
              parent="menu_satu_data_konfigurasi" action="action_periode"
              groups="satu_data.group_satu_data_admin" sequence="2"/>
    <menuitem id="menu_satu_data_instansi" name="Instansi"
              parent="menu_satu_data_konfigurasi" action="action_instansi"
              groups="satu_data.group_satu_data_admin" sequence="3"/>
    <menuitem id="menu_satu_data_topik" name="Topik Data"
              parent="menu_satu_data_konfigurasi" action="action_topik"
              groups="satu_data.group_satu_data_admin" sequence="4"/>
    <menuitem id="menu_satu_data_urusan" name="Urusan Pemerintahan"
              parent="menu_satu_data_konfigurasi" action="action_urusan"
              groups="satu_data.group_satu_data_admin" sequence="5"/>

</odoo>
