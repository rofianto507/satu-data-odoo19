<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Instansi ════════════════════════════════════════════════════════ -->

    <record id="view_instansi_list" model="ir.ui.view">
        <field name="name">satu_data.instansi.list</field>
        <field name="model">satu_data.instansi</field>
        <field name="arch" type="xml">
            <list string="Instansi">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="singkatan"/>
                <field name="peran"/>
                <field name="jenis" optional="show"/>
                <field name="urusan_ids" widget="many2many_tags" optional="show"/>
                <field name="jumlah_data"/>
                <field name="persen_tepat" string="Tepat Waktu (%)" optional="show"
                       invisible="not jumlah_pengajuan"/>
                <field name="jumlah_pengajuan" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_instansi_form" model="ir.ui.view">
        <field name="name">satu_data.instansi.form</field>
        <field name="model">satu_data.instansi</field>
        <field name="arch" type="xml">
            <form string="Instansi">
                <sheet>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Mis. Dinas Kesehatan"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="singkatan"/>
                            <field name="kode"/>
                            <field name="peran" widget="radio"/>
                            <field name="jenis"/>
                            <field name="urusan_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="telepon" widget="phone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Kinerja Pemutakhiran Data" invisible="peran != 'produsen'">
                        <group>
                            <field name="jumlah_pengajuan"/>
                            <field name="jumlah_tepat"/>
                            <field name="persen_tepat"/>
                        </group>
                        <div class="text-muted">
                            Ketepatan waktu dihitung dari tanggal pertama data diajukan ke Walidata
                            dibandingkan batas pengajuan (jadwal pemutakhiran di Daftar Data).
                        </div>
                    </group>
                    <notebook>
                        <page string="Daftar Data" name="data">
                            <field name="data_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="urusan_id"/>
                                    <field name="frekuensi"/>
                                    <field name="status_daftar"/>
                                    <field name="memenuhi_sdi" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Petugas" name="petugas">
                            <field name="user_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                Petugas diatur oleh admin sistem di Pengaturan > Pengguna, isian "Instansi Satu Data".
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_instansi" model="ir.actions.act_window">
        <field name="name">Instansi</field>
        <field name="res_model">satu_data.instansi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tambahkan instansi</p>
            <p>Produsen Data (perangkat daerah), Walidata (Diskominfo), Walidata Pendukung,
               Sekretariat Satu Data (Bappeda), dan Pembina Data (BPS).</p>
        </field>
    </record>

    <!-- ══ Urusan Pemerintahan ═════════════════════════════════════════════ -->

    <record id="view_urusan_list" model="ir.ui.view">
        <field name="name">satu_data.urusan.list</field>
        <field name="model">satu_data.urusan</field>
        <field name="arch" type="xml">
            <list string="Urusan Pemerintahan" editable="bottom">
                <field name="kode"/>
                <field name="name"/>
                <field name="jenis"/>
                <field name="jumlah_data"/>
            </list>
        </field>
    </record>

    <record id="view_urusan_search" model="ir.ui.view">
        <field name="name">satu_data.urusan.search</field>
        <field name="model">satu_data.urusan</field>
        <field name="arch" type="xml">
            <search string="Cari Urusan">
                <field name="name" filter_domain="['|', ('kode', 'ilike', self), ('name', 'ilike', self)]"/>
                <filter string="Diarsipkan" name="arsip" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Jenis Urusan" name="group_jenis" context="{'group_by': 'jenis'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_urusan" model="ir.actions.act_window">
        <field name="name">Urusan Pemerintahan</field>
        <field name="res_model">satu_data.urusan</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_urusan_search"/>
        <field name="context">{'search_default_group_jenis': 1}</field>
    </record>

    <!-- ══ Forum Satu Data ═════════════════════════════════════════════════ -->

    <record id="view_forum_list" model="ir.ui.view">
        <field name="name">satu_data.forum.list</field>
        <field name="model">satu_data.forum</field>
        <field name="arch" type="xml">
            <list string="Forum Satu Data">
                <field name="tahun"/>
                <field name="name"/>
                <field name="tanggal"/>
                <field name="tempat" optional="show"/>
                <field name="jumlah_data"/>
                <field name="jumlah_prioritas"/>
                <field name="state" widget="badge" decoration-success="state == 'ditetapkan'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_forum_form" model="ir.ui.view">
        <field name="name">satu_data.forum.form</field>
        <field name="model">satu_data.forum</field>
        <field name="arch" type="xml">
            <form string="Forum Satu Data">
                <header>
                    <button name="action_tetapkan" type="object" string="Tetapkan Daftar Data"
                            class="btn-primary" invisible="state != 'draf'"
                            groups="satu_data.group_satu_data_walidata"
                            confirm="Tetapkan hasil forum? Semua data di daftar ini berstatus Disepakati."/>
                    <button name="action_buka_kembali" type="object" string="Buka Kembali"
                            invisible="state != 'ditetapkan'" groups="satu_data.group_satu_data_walidata"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_lihat_data" type="object" class="oe_stat_button" icon="fa-database">
                            <field name="jumlah_data" widget="statinfo" string="Data"/>
                        </button>
                        <button name="action_lihat_data" type="object" class="oe_stat_button" icon="fa-star">
                            <field name="jumlah_prioritas" widget="statinfo" string="Prioritas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" class="oe_inline" readonly="state == 'ditetapkan'"/>
                            <field name="tahun" class="oe_inline ms-2" options="{'format': false}"
                                   readonly="state == 'ditetapkan'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tanggal"/>
                            <field name="tempat"/>
                        </group>
                        <group>
                            <field name="berita_acara" filename="berita_acara_nama"/>
                            <field name="berita_acara_nama" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state == 'ditetapkan'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daftar Data" name="data">
                            <field name="data_ids" widget="many2many" readonly="state == 'ditetapkan'"
                                   context="{'search_default_group_instansi': 1}">
                                <list>
                                    <field name="name"/>
                                    <field name="instansi_id"/>
                                    <field name="urusan_id"/>
                                    <field name="frekuensi"/>
                                    <field name="batas_hari"/>
                                    <field name="prioritas"/>
                                    <field name="status_daftar" widget="badge"
                                           decoration-success="status_daftar == 'disepakati'"
                                           decoration-muted="status_daftar == 'dihentikan'"/>
                                    <field name="memenuhi_sdi" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                Pilih data yang disepakati (tombol "Tambahkan baris"). Data prioritas dan
                                batas pengajuan (jadwal pemutakhiran) diatur di masing-masing Daftar Data.
                            </div>
                        </page>
                        <page string="Hasil dan Kesepakatan" name="hasil">
                            <field name="keterangan" placeholder="Ringkasan hasil forum, kesepakatan jadwal, catatan Pembina Data..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_forum" model="ir.actions.act_window">
        <field name="name">Forum Satu Data</field>
        <field name="res_model">satu_data.forum</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Catat Forum Satu Data</p>
            <p>Forum Satu Data menyepakati Daftar Data, data prioritas, dan jadwal pemutakhiran
               untuk satu tahun. Unggah berita acaranya di sini.</p>
        </field>
    </record>

    <!-- ══ Topik ═══════════════════════════════════════════════════════════ -->

    <record id="view_topik_list" model="ir.ui.view">
        <field name="name">satu_data.topik.list</field>
        <field name="model">satu_data.topik</field>
        <field name="arch" type="xml">
            <list string="Topik" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="ikon"/>
            </list>
        </field>
    </record>

    <record id="action_topik" model="ir.actions.act_window">
        <field name="name">Topik Data</field>
        <field name="res_model">satu_data.topik</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ══ Metadata Kegiatan ═══════════════════════════════════════════════ -->

    <record id="view_kegiatan_list" model="ir.ui.view">
        <field name="name">satu_data.kegiatan.list</field>
        <field name="model">satu_data.kegiatan</field>
        <field name="arch" type="xml">
            <list string="Metadata Kegiatan">
                <field name="name"/>
                <field name="instansi_id"/>
                <field name="jenis"/>
                <field name="frekuensi"/>
            </list>
        </field>
    </record>

    <record id="view_kegiatan_form" model="ir.ui.view">
        <field name="name">satu_data.kegiatan.form</field>
        <field name="model">satu_data.kegiatan</field>
        <field name="arch" type="xml">
            <form string="Metadata Kegiatan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Mis. Laporan bulanan puskesmas"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="instansi_id" options="{'no_create': True}"/>
                            <field name="jenis"/>
                            <field name="frekuensi"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Uraian">
                        <field name="tujuan" nolabel="1" colspan="2" placeholder="Tujuan kegiatan"/>
                        <field name="keterangan" nolabel="1" colspan="2"
                               placeholder="Sumber dan alur data, mis. laporan bulanan puskesmas ke Dinas Kesehatan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kegiatan" model="ir.actions.act_window">
        <field name="name">Metadata Kegiatan</field>
        <field name="res_model">satu_data.kegiatan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══ Daftar Data ═════════════════════════════════════════════════════ -->

    <record id="view_data_list" model="ir.ui.view">
        <field name="name">satu_data.data.list</field>
        <field name="model">satu_data.data</field>
        <field name="arch" type="xml">
            <list string="Daftar Data" decoration-muted="not active">
                <field name="name"/>
                <field name="instansi_id"/>
                <field name="urusan_id" optional="show"/>
                <field name="topik_id" optional="hide"/>
                <field name="frekuensi" optional="show"/>
                <field name="batas_hari" optional="hide"/>
                <field name="status_daftar" widget="badge" optional="show"
                       decoration-success="status_daftar == 'disepakati'"
                       decoration-muted="status_daftar == 'dihentikan'"/>
                <field name="tahun_daftar" optional="hide" options="{'format': false}"/>
                <field name="satuan" optional="show"/>
                <field name="akses" widget="badge" decoration-success="akses == 'terbuka'"
                       decoration-warning="akses == 'terbatas'" decoration-danger="akses == 'tertutup'"/>
                <field name="prioritas" optional="show"/>
                <field name="tahun_tersedia" optional="show"/>
                <field name="memenuhi_sdi" widget="boolean_toggle" readonly="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_data_form" model="ir.ui.view">
        <field name="name">satu_data.data.form</field>
        <field name="model">satu_data.data</field>
        <field name="arch" type="xml">
            <form string="Daftar Data">
                <header>
                    <button name="action_hentikan" type="object" string="Hentikan"
                            invisible="status_daftar == 'dihentikan'" groups="satu_data.group_satu_data_walidata"
                            confirm="Data ini tidak lagi dikumpulkan?"/>
                    <button name="action_jadikan_usulan" type="object" string="Jadikan Usulan"
                            invisible="status_daftar != 'dihentikan'" groups="satu_data.group_satu_data_walidata"/>
                    <field name="status_daftar" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-warning mb-3" role="alert" invisible="memenuhi_sdi">
                        <strong>Data ini belum memenuhi prinsip Satu Data Indonesia.</strong>
                        Lengkapi metadata: <field name="metadata_kurang" readonly="1" class="d-inline"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nama data"/></h1>
                        <field name="kode" readonly="sektor" class="text-muted"/>
                    </div>
                    <group>
                        <group string="Identitas">
                            <field name="instansi_id" options="{'no_create': True}"/>
                            <field name="kegiatan_id" options="{'no_create': True}"/>
                            <field name="urusan_id" options="{'no_create': True}"/>
                            <field name="topik_id" options="{'no_create': True}"/>
                            <field name="sektor" readonly="1" invisible="not sektor"/>
                            <field name="jenis"/>
                            <field name="tag" placeholder="kesehatan, ibu, anak"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="memenuhi_sdi" invisible="1"/>
                        </group>
                        <group string="Penyajian">
                            <field name="frekuensi"/>
                            <field name="tingkat_penyajian"/>
                            <field name="akses" widget="radio" options="{'horizontal': true}"/>
                            <field name="tahun_tersedia"/>
                            <field name="terakhir_terbit"/>
                        </group>
                    </group>
                    <group string="Perencanaan (Forum Satu Data)">
                        <group>
                            <field name="prioritas"/>
                            <field name="forum_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <label for="batas_hari"/>
                            <div class="o_row">
                                <field name="batas_hari" class="oe_inline"/>
                                <span>hari</span>
                                <field name="acuan_batas" class="oe_inline"/>
                            </div>
                            <field name="jadwal_pemutakhiran" invisible="not batas_hari"/>
                        </group>
                    </group>
                    <group string="Standar Data">
                        <group>
                            <field name="ukuran" placeholder="Jumlah / Persentase / Rasio"/>
                            <field name="satuan" placeholder="Jiwa / Persen / Per 1.000 kelahiran hidup"/>
                            <field name="klasifikasi_penyajian" placeholder="Kecamatan, Desa/Kelurahan; Jenis kelamin"/>
                        </group>
                        <group>
                            <field name="kode_sds"/>
                            <field name="tipe_sds"/>
                            <field name="versi_sds"/>
                        </group>
                    </group>
                    <group>
                        <field name="konsep" placeholder="Konsep yang mendasari data"/>
                        <field name="definisi" placeholder="Definisi baku"/>
                        <field name="metode" placeholder="Cara perhitungan atau rumus"/>
                    </group>
                    <group string="Referensi">
                        <group>
                            <field name="kode_referensi" placeholder="Kode wilayah Kemendagri"/>
                            <field name="versi_kode_referensi"/>
                        </group>
                        <group>
                            <field name="sumber_referensi" placeholder="Mis. Permenkes tentang SPM Kesehatan"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_data_search" model="ir.ui.view">
        <field name="name">satu_data.data.search</field>
        <field name="model">satu_data.data</field>
        <field name="arch" type="xml">
            <search string="Cari Data">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('kode', 'ilike', self), ('tag', 'ilike', self)]"/>
                <field name="instansi_id"/>
                <field name="urusan_id"/>
                <field name="topik_id"/>
                <field name="forum_id"/>
                <separator/>
                <filter string="Data Prioritas" name="prioritas" domain="[('prioritas', '=', True)]"/>
                <filter string="Belum Memenuhi SDI" name="belum_sdi" domain="[('memenuhi_sdi', '=', False)]"/>
                <separator/>
                <filter string="Usulan" name="usulan" domain="[('status_daftar', '=', 'usulan')]"/>
                <filter string="Disepakati" name="disepakati" domain="[('status_daftar', '=', 'disepakati')]"/>
                <filter string="Dihentikan" name="dihentikan" domain="[('status_daftar', '=', 'dihentikan')]"/>
                <separator/>
                <filter string="Terbuka" name="terbuka" domain="[('akses', '=', 'terbuka')]"/>
                <filter string="Terbatas" name="terbatas" domain="[('akses', '=', 'terbatas')]"/>
                <separator/>
                <filter string="Diarsipkan" name="arsip" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Produsen Data" name="group_instansi" context="{'group_by': 'instansi_id'}"/>
                    <filter string="Urusan" name="group_urusan" context="{'group_by': 'urusan_id'}"/>
                    <filter string="Topik" name="group_topik" context="{'group_by': 'topik_id'}"/>
                    <filter string="Status Daftar Data" name="group_status" context="{'group_by': 'status_daftar'}"/>
                    <filter string="Sektor" name="group_sektor" context="{'group_by': 'sektor'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_data" model="ir.actions.act_window">
        <field name="name">Daftar Data</field>
        <field name="res_model">satu_data.data</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_data_search"/>
        <field name="context">{'search_default_group_instansi': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada data di Daftar Data</p>
            <p>Data dari modul sektor (kependudukan, kesehatan, ...) terdaftar otomatis beserta
               metadatanya; Walidata dan Pembina Data melengkapi standar data dan metadata.</p>
        </field>
    </record>

    <!-- ══ Pengajuan / Pemeriksaan ═════════════════════════════════════════ -->

    <record id="view_pengajuan_list" model="ir.ui.view">
        <field name="name">satu_data.pengajuan.list</field>
        <field name="model">satu_data.pengajuan</field>
        <field name="arch" type="xml">
            <list string="Pemeriksaan Laporan" create="0">
                <field name="sektor"/>
                <field name="periode_id"/>
                <field name="instansi_id"/>
                <field name="jumlah_terisi"/>
                <field name="jumlah_kosong" optional="show"/>
                <field name="perlu_perbaikan" column_invisible="1"/>
                <field name="batas_pengajuan" optional="show"/>
                <field name="tanggal_diajukan" optional="show"/>
                <field name="ketepatan" widget="badge" optional="show"
                       decoration-success="ketepatan == 'tepat'" decoration-danger="ketepatan == 'terlambat'"/>
                <field name="tanggal_diperiksa" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'diajukan'"
                       decoration-success="state == 'terbit'"
                       decoration-warning="state == 'draf' and perlu_perbaikan"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pengajuan_form" model="ir.ui.view">
        <field name="name">satu_data.pengajuan.form</field>
        <field name="model">satu_data.pengajuan</field>
        <field name="arch" type="xml">
            <form string="Laporan Data" create="0">
                <header>
                    <button name="action_ajukan" type="object" string="Kirim ke Walidata" class="btn-primary"
                            invisible="state != 'draf'" groups="satu_data.group_satu_data_operator"
                            confirm="Kirim laporan ke Walidata? Data dikunci selama diperiksa. Desa yang belum terisi tidak akan tampil di dashboard."/>
                    <button name="action_lengkapi_baris" type="object" string="Tambah Desa yang Belum Ada"
                            invisible="state != 'draf' or jumlah_record &gt;= jumlah_desa"
                            groups="satu_data.group_satu_data_operator"/>
                    <button name="action_tarik" type="object" string="Batalkan Kirim"
                            invisible="state != 'diajukan'" groups="satu_data.group_satu_data_operator"/>
                    <button name="action_terbitkan" type="object" string="Terbitkan" class="btn-primary"
                            invisible="state != 'diajukan'" groups="satu_data.group_satu_data_walidata"
                            confirm="Terbitkan data ini? Data akan tampil di dashboard dan tidak bisa diubah Produsen Data."/>
                    <button name="action_kembalikan" type="object" string="Kembalikan untuk Perbaikan"
                            invisible="state not in ('diajukan', 'terbit')" groups="satu_data.group_satu_data_walidata"/>
                    <field name="state" widget="statusbar" statusbar_visible="draf,diajukan,terbit"/>
                </header>
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert" invisible="not perlu_perbaikan">
                        <strong>Dikembalikan Walidata untuk diperbaiki.</strong>
                        Lihat Catatan Pemeriksaan di bawah.
                    </div>
                    <div class="alert alert-info mb-3" role="status"
                         invisible="state == 'terbit' or not jumlah_kosong">
                        <field name="jumlah_kosong" readonly="1" class="d-inline"/> dari
                        <field name="jumlah_desa" readonly="1" class="d-inline"/>
                        <field name="satuan_baris" readonly="1" class="d-inline"/> belum terisi.
                        Laporan tetap bisa dikirim, tetapi baris yang kosong tidak tampil di dashboard.
                    </div>
                    <field name="perlu_perbaikan" invisible="1"/>
                    <field name="jumlah_record" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_lihat_data" type="object" class="oe_stat_button" icon="fa-table">
                            <field name="jumlah_terisi" widget="statinfo" string="Desa Terisi"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sektor" readonly="1"/>
                            <field name="periode_id" readonly="1"/>
                            <field name="instansi_id" readonly="state in ('diajukan', 'terbit')"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="batas_pengajuan"/>
                            <field name="tanggal_diajukan_pertama" invisible="not tanggal_diajukan_pertama"/>
                            <field name="ketepatan" invisible="not ketepatan" widget="badge"
                                   decoration-success="ketepatan == 'tepat'" decoration-danger="ketepatan == 'terlambat'"/>
                            <field name="hari_terlambat" invisible="ketepatan != 'terlambat'"/>
                            <field name="diajukan_oleh"/>
                            <field name="tanggal_diajukan"/>
                            <field name="diperiksa_oleh"/>
                            <field name="tanggal_diperiksa"/>
                        </group>
                    </group>
                    <group string="Catatan Pemeriksaan Walidata" name="catatan">
                        <field name="boleh_periksa" invisible="1"/>
                        <field name="catatan" nolabel="1" colspan="2" readonly="not boleh_periksa"
                               placeholder="Diisi Walidata. Wajib diisi saat data dikembalikan untuk perbaikan."/>
                    </group>
                    <div class="text-muted">
                        Data yang sedang diperiksa atau sudah terbit dikunci dan tidak bisa diubah Produsen Data.
                        Dashboard hanya menampilkan data berstatus Terbit.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pengajuan_search" model="ir.ui.view">
        <field name="name">satu_data.pengajuan.search</field>
        <field name="model">satu_data.pengajuan</field>
        <field name="arch" type="xml">
            <search string="Cari Pengajuan">
                <field name="periode_id"/>
                <field name="instansi_id"/>
                <separator/>
                <filter string="Menunggu Pemeriksaan" name="diajukan" domain="[('state', '=', 'diajukan')]"/>
                <filter string="Perlu Perbaikan" name="perlu_perbaikan" domain="[('perlu_perbaikan', '=', True)]"/>
                <filter string="Diisi" name="draf" domain="[('state', '=', 'draf')]"/>
                <filter string="Terbit" name="terbit" domain="[('state', '=', 'terbit')]"/>
                <separator/>
                <filter string="Lewat Batas, Belum Diajukan" name="lewat_batas"
                        domain="[('tanggal_diajukan_pertama', '=', False), ('batas_pengajuan', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Tepat Waktu" name="tepat" domain="[('ketepatan', '=', 'tepat')]"/>
                <filter string="Terlambat" name="terlambat" domain="[('ketepatan', '=', 'terlambat')]"/>
                <group>
                    <filter string="Produsen Data" name="group_instansi" context="{'group_by': 'instansi_id'}"/>
                    <filter string="Ketepatan" name="group_ketepatan" context="{'group_by': 'ketepatan'}"/>
                    <filter string="Sektor" name="group_sektor" context="{'group_by': 'sektor'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pengajuan" model="ir.actions.act_window">
        <field name="name">Pemeriksaan Data</field>
        <field name="res_model">satu_data.pengajuan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pengajuan_search"/>
        <field name="context">{'search_default_diajukan': 1, 'search_default_group_sektor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tidak ada laporan yang menunggu pemeriksaan</p>
            <p>Laporan yang dikirim Produsen Data muncul di sini. Walidata memeriksa, lalu
               menerbitkan atau mengembalikannya dengan catatan.</p>
        </field>
    </record>

    <!-- Wizard "Ajukan Periode" (dipanggil dari menu data sektor) -->
    <record id="view_pengajuan_wizard_form" model="ir.ui.view">
        <field name="name">satu_data.pengajuan.wizard.form</field>
        <field name="model">satu_data.pengajuan.wizard</field>
        <field name="arch" type="xml">
            <form string="Buka Laporan">
                <group>
                    <field name="sektor" invisible="1"/>
                    <field name="frekuensi" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="periode_id" options="{'no_create': True}"/>
                    <field name="instansi_id" options="{'no_create': True}"/>
                </group>
                <div class="text-muted">
                    Membuka laporan periode ini. Bila belum ada, laporan dibuat
                    beserta baris desa/kelurahannya.
                </div>
                <footer>
                    <button string="Buka Laporan" name="action_buka" type="object" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ══ Pengguna: instansi Satu Data ════════════════════════════════════ -->

    <record id="view_users_form_satu_data" model="ir.ui.view">
        <field name="name">res.users.form.satu_data</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Satu Data" name="satu_data">
                    <group>
                        <field name="sd_instansi_id" options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
