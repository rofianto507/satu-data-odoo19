<!--
    Daftar Data indikator kesehatan (dihitung dari rekap bulanan dan sasaran tahunan).
    Dibuat dari konstanta INDIKATOR (models/indikator.py). noupdate: Walidata/Pembina Data
    boleh melengkapi isian (mis. tingkat penyajian) tanpa tertimpa upgrade.
-->
<odoo noupdate="1">

    <record id="data_spm_ibu_hamil" model="satu_data.data">
        <field name="name">Pelayanan Kesehatan Ibu Hamil</field>
        <field name="kode">kesehatan.spm_ibu_hamil</field>
        <field name="sequence">1</field>
        <field name="sektor">kesehatan</field>
        <field name="jenis">indikator</field>
        <field name="instansi_id" ref="instansi_dinkes"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="kegiatan_id" ref="kegiatan_laporan_bulanan"/>
        <field name="topik_id" ref="satu_data.topik_kesehatan"/>
        <field name="urusan_id" ref="satu_data.urusan_1_02"/>
        <field name="prioritas" eval="False"/>
        <field name="definisi">Persentase ibu hamil yang mendapat pelayanan kesehatan sesuai standar dibanding sasaran tahunan (SPM 1).</field>
        <field name="metode">Dilayani sesuai standar (kumulatif Januari s.d. bulan laporan) dibagi sasaran tahunan, dikali 100. Untuk wilayah yang lebih besar, pembilang dan penyebut desa/kelurahan dijumlahkan dulu baru dibagi (bukan rata-rata rasio).</field>
        <field name="ukuran">Persentase</field>
        <field name="satuan">Persen</field>
        <field name="klasifikasi_penyajian">Kabupaten/Kota, Kecamatan, Puskesmas, Desa/Kelurahan; Bulan</field>
        <field name="tingkat_penyajian">desa</field>
        <field name="frekuensi">bulanan</field>
        <field name="batas_hari">10</field>
        <field name="acuan_batas">akhir</field>
        <field name="akses">terbuka</field>
        <field name="kode_referensi">Kode wilayah administrasi pemerintahan Kemendagri; kode fasilitas pelayanan kesehatan Kemenkes</field>
        <field name="versi_kode_referensi">Kepmendagri No 300.2.2-2430 Tahun 2025</field>
        <field name="sumber_referensi">Permenkes No 6 Tahun 2024 tentang Standar Teknis Pemenuhan Standar Pelayanan Minimal Kesehatan</field>
        <field name="tag">kesehatan, standar pelayanan minimal</field>
    </record>

