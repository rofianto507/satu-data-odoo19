<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Favicon backend dan halaman login: ikon aplikasi Satu Data, bukan logo Odoo.
         Halaman website tetap memakai favicon website (x_icon diisi oleh website.layout). -->
    <template id="favicon_satu_data" inherit_id="web.layout" name="Satu Data: Favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/satu_data_portal/static/description/icon.png'</attribute>
            <attribute name="type">image/png</attribute>
        </xpath>
    </template>

    <!-- Pengumuman di atas header (diatur lewat parameter sistem satu_data_portal.pengumuman). -->
    <template id="pengumuman_portal" inherit_id="website.layout" name="Satu Data: Pengumuman">
        <xpath expr="//header" position="before">
            <t t-set="sd_pengumuman" t-value="website and website.sd_pengumuman()"/>
            <div t-if="sd_pengumuman" class="sd-pengumuman" role="note">
                <i class="fa fa-info-circle" aria-hidden="true"/> <span t-esc="sd_pengumuman"/>
            </div>
        </xpath>
    </template>

    <!-- Merek di navbar: nama aplikasi dan wilayah di samping logo. -->
    <template id="merek_navbar" inherit_id="website.option_header_brand_logo" name="Satu Data: Merek Navbar">
        <xpath expr="//a[@data-name='Navbar Logo']" position="inside">
            <span class="sd-nav-merek">
                <strong>Satu Data</strong>
                <small t-esc="website.sd_nama_wilayah()"/>
            </span>
        </xpath>
    </template>
</odoo>
