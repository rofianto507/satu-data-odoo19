<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="satu_data_kependudukan.GrafikPenduduk">
        <div class="sd-grafik-wadah">
            <div t-ref="grafik" class="sd-grafik-kanvas" t-att-class="{ 'invisible': !adaData }"/>
            <div t-if="state.galat" class="sd-grafik-pesan">
                <i class="fa fa-exclamation-triangle" aria-hidden="true"/> Pustaka grafik (ECharts) gagal dimuat.
            </div>
            <div t-elif="!adaData" class="sd-grafik-pesan">
                <i class="fa fa-bar-chart" aria-hidden="true"/> Belum ada data untuk periode ini.
            </div>
        </div>
    </t>

</templates>
