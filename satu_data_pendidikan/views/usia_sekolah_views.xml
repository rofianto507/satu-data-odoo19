<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_usia_sekolah_list" model="ir.ui.view">
        <field name="name">satu_data.pendidikan.usia_sekolah.list</field>
        <field name="model">satu_data.pendidikan.usia_sekolah</field>
        <field name="arch" type="xml">
            <list string="Penduduk Usia Sekolah" create="0">
                <field name="periode_id"/>
                <field name="kecamatan_id"/>
                <field name="desa_id"/>
                <field name="usia_5_6" sum="Total"/>
                <field name="usia_7_12" sum="Total"/>
                <field name="usia_13_15" sum="Total"/>
                <field name="usia_16_18" sum="Total"/>
                <field name="usia_total" sum="Total" optional="show"/>
                <field name="sumber" optional="hide"/>
                <field name="terisi" optional="show"/>
                <field name="sd_status" widget="badge" optional="show"
                       decoration-info="sd_status == 'diajukan'" decoration-success="sd_status == 'terbit'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Isian cepat per kecamatan (tombol "Isi per Kecamatan" di laporan): edit langsung di baris. -->
    <record id="view_usia_sekolah_list_isian" model="ir.ui.view">
        <field name="name">satu_data.pendidikan.usia_sekolah.list.isian</field>
        <field name="model">satu_data.pendidikan.usia_sekolah</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Isian Penduduk Usia Sekolah" editable="bottom" create="0">
                <field name="sd_status" column_invisible="1"/>
                <field name="terisi" readonly="1" string="Terisi"/>
                <field name="desa_id" readonly="1"/>
                <field name="usia_5_6" sum="Total"/>
                <field name="usia_7_12" sum="Total"/>
                <field name="usia_13_15" sum="Total"/>
                <field name="usia_16_18" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_usia_sekolah_form" model="ir.ui.view">
        <field name="name">satu_data.pendidikan.usia_sekolah.form</field>
        <field name="model">satu_data.pendidikan.usia_sekolah</field>
        <field name="arch" type="xml">
            <form string="Penduduk Usia Sekolah" create="0">
                <header>
                    <field name="sd_status" widget="statusbar" statusbar_visible="draf,diajukan,terbit"/>
                </header>
                <sheet>
                    <div class="alert alert-info mb-3" role="status"
                         invisible="sd_status not in ('diajukan', 'terbit')">
                        Data tahun ini sedang diperiksa atau sudah terbit sehingga dikunci.
                        Minta Walidata mengembalikannya (menu Pemeriksaan) bila perlu diperbaiki.
                    </div>
                    <div class="oe_title">
                        <label for="desa_id"/>
                        <h1><field name="desa_id" options="{'no_create': True}" placeholder="Pilih desa/kelurahan"/></h1>
                    </div>
                    <group>
                        <group string="Wilayah dan Tahun">
                            <field name="kecamatan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="periode_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="sumber" placeholder="Mis. Proyeksi penduduk BPS 2026"/>
                            <field name="terisi"/>
                        </group>
                        <group string="Penduduk Menurut Kelompok Usia Sekolah">
                            <field name="usia_5_6"/>
                            <field name="usia_7_12"/>
                            <field name="usia_13_15"/>
                            <field name="usia_16_18"/>
                            <field name="usia_total"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Hanya angka rekap per desa/kelurahan, tanpa data perorangan. Angka kecamatan dan
                        kabupaten/kota dihitung dari desa/kelurahan. Kecamatan dicatat sesuai kecamatan
                        desa saat data ini dibuat.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_usia_sekolah_search" model="ir.ui.view">
        <field name="name">satu_data.pendidikan.usia_sekolah.search</field>
        <field name="model">satu_data.pendidikan.usia_sekolah</field>
        <field name="arch" type="xml">
            <search string="Cari Penduduk Usia Sekolah">
                <field name="desa_id"/>
                <field name="kecamatan_id"/>
                <field name="periode_id"/>
                <separator/>
                <filter string="Belum Terisi" name="belum_terisi" domain="[('terisi', '=', False)]"/>
                <group>
                    <filter string="Tahun" name="group_periode" context="{'group_by': 'periode_id'}"/>
                    <filter string="Kecamatan" name="group_kecamatan" context="{'group_by': 'kecamatan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_usia_sekolah_pivot" model="ir.ui.view">
        <field name="name">satu_data.pendidikan.usia_sekolah.pivot</field>
        <field name="model">satu_data.pendidikan.usia_sekolah</field>
        <field name="arch" type="xml">
            <pivot string="Penduduk Usia Sekolah">
                <field name="kecamatan_id" type="row"/>
                <field name="periode_id" type="col"/>
                <field name="usia_7_12" type="measure"/>
                <field name="usia_13_15" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_usia_sekolah" model="ir.actions.act_window">
        <field name="name">Analisis Usia Sekolah</field>
        <field name="res_model">satu_data.pendidikan.usia_sekolah</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_usia_sekolah_search"/>
        <field name="context">{'search_default_group_periode': 1, 'search_default_group_kecamatan': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada data penduduk usia sekolah</p>
            <p>Data diisi lewat Laporan Penduduk Usia Sekolah. Menu ini untuk menganalisis data semua tahun.</p>
        </field>
    </record>

</odoo>
