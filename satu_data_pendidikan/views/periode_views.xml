<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_periode_form_pendidikan" model="ir.ui.view">
        <field name="name">satu_data.periode.form.pendidikan</field>
        <field name="model">satu_data.periode</field>
        <field name="inherit_id" ref="satu_data.view_periode_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_lihat_usia_sekolah" type="object" class="oe_stat_button"
                        icon="fa-graduation-cap" invisible="not id or frekuensi != 'tahunan'">
                    <field name="jumlah_usia_sekolah" widget="statinfo" string="Usia Sekolah"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
