<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hanya wilayah (company) yang sedang dipilih pengguna. -->
    <record id="rule_statistik_company" model="ir.rule">
        <field name="name">Statistik portal: wilayah pengguna</field>
        <field name="model_id" ref="model_satu_data_portal_statistik"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_permintaan_company" model="ir.rule">
        <field name="name">Permintaan data: wilayah pengguna</field>
        <field name="model_id" ref="model_satu_data_permintaan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_api_key_company" model="ir.rule">
        <field name="name">Kunci API: wilayah pengguna</field>
        <field name="model_id" ref="model_satu_data_api_key"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
