<?xml version="1.0" encoding="utf-8"?>
<!--
    Produsen Data, Metadata Kegiatan, dan Daftar Data sektor kesehatan (prinsip Satu Data
    Indonesia: standar data, metadata, kode referensi). noupdate: Walidata/Pembina Data
    boleh melengkapi isian tanpa tertimpa upgrade.
-->
<odoo noupdate="1">

    <record id="instansi_dinkes" model="satu_data.instansi">
        <field name="name">Dinas Kesehatan</field>
        <field name="singkatan">Dinkes</field>
        <field name="jenis">opd</field>
        <field name="peran">produsen</field>
        <field name="sequence">30</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="urusan_ids" eval="[(6, 0, [ref('satu_data.urusan_1_02')])]"/>
    </record>

    <record id="kegiatan_laporan_bulanan" model="satu_data.kegiatan">
        <field name="name">Laporan Bulanan Pelayanan Kesehatan Puskesmas</field>
        <field name="instansi_id" ref="instansi_dinkes"/>
        <field name="jenis">kompilasi</field>
        <field name="frekuensi">bulanan</field>
        <field name="tujuan">Memantau capaian Standar Pelayanan Minimal bidang kesehatan, imunisasi, stunting, kematian ibu dan bayi, serta DBD per desa/kelurahan setiap bulan.</field>
        <field name="keterangan">Puskesmas merekap pelayanan dan kejadian per desa/kelurahan tempat tinggal sasaran di wilayah kerjanya, lalu Dinas Kesehatan menghimpun dan mengajukannya ke Walidata paling lambat tanggal 10 bulan berikutnya. Hanya angka rekap, tanpa data perorangan.</field>
    </record>

    <record id="kegiatan_sasaran" model="satu_data.kegiatan">
        <field name="name">Penetapan Sasaran Program Kesehatan Tahunan</field>
        <field name="instansi_id" ref="instansi_dinkes"/>
        <field name="jenis">kompilasi</field>
        <field name="frekuensi">tahunan</field>
        <field name="tujuan">Menyediakan sasaran (penyebut) capaian Standar Pelayanan Minimal bidang kesehatan dan indikator kesehatan per desa/kelurahan.</field>
        <field name="keterangan">Dinas Kesehatan menetapkan sasaran per desa/kelurahan pada awal tahun dari proyeksi penduduk dan estimasi prevalensi; puskesmas memverifikasi untuk wilayah kerjanya. Hanya angka rekap, tanpa data perorangan.</field>
    </record>

    <record id="data_sasaran_ibu_hamil" model="satu_data.data">
        <field name="name">Sasaran Ibu Hamil</field>
        <field name="kode">kesehatan.sasaran_ibu_hamil</field>
