<?xml version="1.0" encoding="utf-8"?>
<!--
    Produsen Data, Metadata Kegiatan, dan Daftar Data sektor pendidikan (prinsip Satu Data
    Indonesia: standar data, metadata, kode referensi). noupdate: Walidata/Pembina Data
    boleh melengkapi isian tanpa tertimpa upgrade.
-->
<odoo noupdate="1">

    <record id="instansi_disdik" model="satu_data.instansi">
        <field name="name">Dinas Pendidikan</field>
        <field name="singkatan">Disdik</field>
        <field name="jenis">opd</field>
        <field name="peran">produsen</field>
        <field name="sequence">40</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="urusan_ids" eval="[(6, 0, [ref('satu_data.urusan_1_01')])]"/>
    </record>

    <!-- Madrasah (MI, MTs, MA) dibina Kementerian Agama: Produsen Data instansi vertikal.
         Datanya dihimpun Disdik dalam laporan yang sama. -->
    <record id="instansi_kemenag" model="satu_data.instansi">
        <field name="name">Kantor Kementerian Agama</field>
        <field name="singkatan">Kemenag</field>
        <field name="jenis">vertikal</field>
        <field name="peran">produsen</field>
        <field name="sequence">50</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="urusan_ids" eval="[(6, 0, [ref('satu_data.urusan_1_01')])]"/>
    </record>

    <record id="kegiatan_usia_sekolah" model="satu_data.kegiatan">
        <field name="name">Penetapan Penduduk Usia Sekolah Tahunan</field>
        <field name="instansi_id" ref="instansi_disdik"/>
        <field name="jenis">kompilasi</field>
        <field name="frekuensi">tahunan</field>
        <field name="tujuan">Menyediakan jumlah penduduk usia sekolah per desa/kelurahan sebagai penyebut angka partisipasi pendidikan dan dasar perencanaan layanan pendidikan.</field>
        <field name="keterangan">Dinas Pendidikan menetapkan jumlah penduduk menurut kelompok usia sekolah per desa/kelurahan pada awal tahun, bersumber dari proyeksi penduduk (BPS) dan data kependudukan (Dispendukcapil). Hanya angka rekap, tanpa data perorangan.</field>
    </record>

    <record id="data_usia_5_6" model="satu_data.data">
        <field name="name">Penduduk Usia 5–6 Tahun</field>
        <field name="kode">pendidikan.usia_5_6</field>
        <field name="sequence">2</field>
        <field name="sektor">pendidikan_usia_sekolah</field>
        <field name="jenis">variabel</field>
        <field name="instansi_id" ref="instansi_disdik"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="kegiatan_id" ref="kegiatan_usia_sekolah"/>
        <field name="topik_id" ref="satu_data.topik_pendidikan"/>
        <field name="urusan_id" ref="satu_data.urusan_1_01"/>
        <field name="definisi">Jumlah penduduk berusia 5–6 tahun (usia anak PAUD/TK), penyebut angka partisipasi kasar PAUD.</field>
        <field name="metode">Ditetapkan Dinas Pendidikan per desa/kelurahan dari proyeksi penduduk menurut kelompok umur. Angka kecamatan dan kabupaten/kota adalah penjumlahan desa/kelurahan.</field>
        <field name="ukuran">Jumlah</field>
        <field name="satuan">Jiwa</field>
        <field name="klasifikasi_penyajian">Kabupaten/Kota, Kecamatan, Desa/Kelurahan; Kelompok umur</field>
        <field name="tingkat_penyajian">desa</field>
        <field name="frekuensi">tahunan</field>
        <field name="batas_hari">31</field>
        <field name="acuan_batas">awal</field>
        <field name="akses">terbuka</field>
        <field name="kode_referensi">Kode wilayah administrasi pemerintahan Kemendagri</field>
        <field name="versi_kode_referensi">Kepmendagri No 300.2.2-2430 Tahun 2025</field>
        <field name="sumber_referensi">Proyeksi Penduduk Indonesia (BPS) dan data kependudukan (Kemendagri)</field>
        <field name="tag">pendidikan, penduduk usia sekolah, partisipasi</field>
    </record>

