<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_desa_list" model="ir.ui.view">
        <field name="name">satu_data.desa.list</field>
        <field name="model">satu_data.desa</field>
        <field name="arch" type="xml">
            <list string="Desa/Kelurahan">
                <field name="kode"/>
                <field name="name"/>
                <field name="jenis"/>
                <field name="kecamatan_id"/>
                <field name="luas_km2" sum="Total" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_desa_form" model="ir.ui.view">
        <field name="name">satu_data.desa.form</field>
        <field name="model">satu_data.desa</field>
        <field name="arch" type="xml">
            <form string="Desa/Kelurahan">
                <sheet>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nama desa/kelurahan"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kode"/>
                            <field name="jenis" widget="radio" options="{'horizontal': true}"/>
                            <field name="luas_km2"/>
                        </group>
                        <group>
                            <field name="kecamatan_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batas Wilayah (GeoJSON)" name="geojson">
                            <field name="geojson" nolabel="1" widget="sd_geojson_peta"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_desa_search" model="ir.ui.view">
        <field name="name">satu_data.desa.search</field>
        <field name="model">satu_data.desa</field>
        <field name="arch" type="xml">
            <search string="Cari Desa/Kelurahan">
                <field name="name" string="Nama atau Kode" filter_domain="['|', ('name', 'ilike', self), ('kode', 'ilike', self)]"/>
                <field name="kecamatan_id"/>
                <separator/>
                <filter string="Desa" name="jenis_desa" domain="[('jenis', '=', 'desa')]"/>
                <filter string="Kelurahan" name="jenis_kelurahan" domain="[('jenis', '=', 'kelurahan')]"/>
                <separator/>
                <filter string="Tanpa Batas Wilayah" name="tanpa_geojson" domain="[('geojson', '=', False)]"/>
                <filter string="Tanpa Luas" name="tanpa_luas" domain="[('luas_km2', '=', 0)]"/>
                <filter string="Diarsipkan" name="arsip" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Kecamatan" name="group_kecamatan" context="{'group_by': 'kecamatan_id'}"/>
                    <filter string="Jenis" name="group_jenis" context="{'group_by': 'jenis'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_desa" model="ir.actions.act_window">
        <field name="name">Desa/Kelurahan</field>
        <field name="res_model">satu_data.desa</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_desa_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tambahkan desa/kelurahan pertama</p>
            <p>Setiap desa/kelurahan berada di satu kecamatan. Data sektoral (kependudukan, dll.) diinput per desa/kelurahan.</p>
        </field>
    </record>

</odoo>
