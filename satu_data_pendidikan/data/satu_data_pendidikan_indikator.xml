<?xml version="1.0" encoding="utf-8"?>
<!--
    Daftar Data indikator pendidikan (dihitung dari rekap semester dan penduduk usia sekolah).
    Dibuat dari konstanta INDIKATOR (models/indikator.py). noupdate: Walidata/Pembina Data
    boleh melengkapi isian (mis. tingkat penyajian) tanpa tertimpa upgrade.
-->
<odoo noupdate="1">

    <record id="kegiatan_rekap_semester" model="satu_data.kegiatan">
        <field name="name">Rekap Pendidikan Semester</field>
        <field name="instansi_id" ref="instansi_disdik"/>
        <field name="jenis">kompilasi</field>
        <field name="frekuensi">semesteran</field>
        <field name="tujuan">Memantau ketersediaan, mutu layanan, partisipasi, dan keberlanjutan pendidikan per desa/kelurahan dan jenjang setiap semester.</field>
        <field name="keterangan">Dinas Pendidikan menghimpun rekap satuan pendidikan, peserta didik, guru, ruang kelas, putus sekolah, dan lulusan per desa/kelurahan dan jenjang (termasuk madrasah dari Kementerian Agama), lalu mengajukannya ke Walidata paling lambat 30 hari setelah semester berakhir. Hanya angka rekap, tanpa data perorangan.</field>
    </record>

    <record id="data_jml_sekolah" model="satu_data.data">
        <field name="name">Jumlah Satuan Pendidikan</field>
        <field name="kode">pendidikan.jml_sekolah</field>
        <field name="sequence">11</field>
        <field name="sektor">pendidikan</field>
        <field name="jenis">indikator</field>
        <field name="instansi_id" ref="instansi_disdik"/>
