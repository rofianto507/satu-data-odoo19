        <field name="kegiatan_id" ref="kegiatan_rekap_semester"/>
        <field name="topik_id" ref="satu_data.topik_pendidikan"/>
        <field name="urusan_id" ref="satu_data.urusan_1_01"/>
        <field name="prioritas" eval="False"/>
        <field name="definisi">Jumlah satuan pendidikan (negeri dan swasta, termasuk madrasah) menurut rekap semester.</field>
        <field name="metode">Dijumlahkan dari rekap semester per desa/kelurahan dan jenjang (baris yang sudah terisi); kecamatan dan kabupaten/kota adalah penjumlahan desa/kelurahan.</field>
        <field name="ukuran">Jumlah</field>
        <field name="satuan">Sekolah</field>
        <field name="klasifikasi_penyajian">Kabupaten/Kota, Kecamatan, Desa/Kelurahan; Semester, Jenjang</field>
        <field name="tingkat_penyajian">desa</field>
        <field name="frekuensi">semesteran</field>
        <field name="batas_hari">30</field>
        <field name="acuan_batas">akhir</field>
        <field name="akses">terbuka</field>
        <field name="kode_referensi">Kode wilayah administrasi pemerintahan Kemendagri; NPSN satuan pendidikan (Kemendikdasmen)</field>
        <field name="versi_kode_referensi">Kepmendagri No 300.2.2-2430 Tahun 2025</field>
        <field name="sumber_referensi">Permendikbudristek No 32 Tahun 2022 tentang Standar Teknis Pemenuhan SPM Pendidikan; Data Pokok Pendidikan (Dapodik); Statistik Pendidikan (BPS)</field>
        <field name="tag">pendidikan, ketersediaan</field>
    </record>

